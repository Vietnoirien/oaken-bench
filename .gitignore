# Sealed bundles (scripts/hidden.sh, issue #35): each ships encrypted as
# <name>.tar.gz.enc and its plaintext directory must never be committed --
# see CANARY.md. Add a line here in the same PR that registers a new bundle
# name in scripts/hidden.sh's BUNDLE_DEFAULT_PASS.
# scripts/tests/test_hidden_bundles.py fails the build if this drifts.
/hidden/
/refengine/
/t3instance/
/t5oracle/

# Vendored offline dependencies. Restore with scripts/bootstrap.sh.
node_modules/
/docker/seed/

# Run artefacts. Raw traces carry agent-written solution code and stay out
# (see CANARY.md); score.json and events-summary.json (issue #7 -- derived
# metrics only, digests never argument text) are the published record.
/results/*/*
!/results/*/score.json
!/results/*/events-summary.json
__pycache__/
*.pyc
.pytest_cache/
