# The held-out suite ships encrypted as hidden.tar.gz.enc.
# Never commit the plaintext -- see CANARY.md.
/hidden/

# Vendored offline dependencies. Restore with scripts/bootstrap.sh.
node_modules/
/docker/seed/

# Run artefacts. Raw traces carry agent-written solution code and stay out
# (see CANARY.md); score.json and events-summary.json (issue #7 -- derived
# metrics only, digests never argument text) are the published record.
/results/*/*
!/results/*/score.json
!/results/*/events-summary.json
__pycache__/
*.pyc
.pytest_cache/
